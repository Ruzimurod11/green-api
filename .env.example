VITE_DEFAULT_URL=https://api.hello.uz/api/v1/

# Dev server porti (ixtiyoriy, default 3000). Dev'da so'rovlar same-origin Vite
# proxy orqali ketgani uchun portni o'zgartirish CORS'ga ta'sir qilmaydi.
VITE_PORT=3000

# Sentry error reporting DSN. Bo'sh qoldirilsa Sentry o'chiq bo'ladi (dev/local).
VITE_SENTRY_DSN=
